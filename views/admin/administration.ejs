<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Administration — July-6 Hall</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main-content">
    <div class="topbar">
      <h1>🧑‍💼 Administration</h1>
      <button class="btn btn-primary" onclick="document.getElementById('addPersonModal').classList.add('show')">+ Add Person</button>
    </div>
    <div class="page-content">
      <%- include('../partials/back-button') %>
      <p style="font-size:13px;color:var(--muted);margin-bottom:18px;">
        Manage the Provost, Assistant Provost, and Hall Staff shown on the public homepage. Photos uploaded here are stored on this server and shown directly — no external links needed.
      </p>

      <div class="card">
        <div class="card-header"><h3>All Entries (<%= people.length %>)</h3></div>
        <div class="table-responsive">
          <% if (people.length) { %>
          <table class="data-table">
            <thead><tr><th>Photo</th><th>Name</th><th>Role</th><th>Designation</th><th>Department</th><th>Contact</th><th>Action</th></tr></thead>
            <tbody>
              <% people.forEach(p => { %>
              <tr>
                <td>
                  <% if (p.photo) { %>
                    <img src="/uploads/administration/<%= p.photo %>" alt="<%= p.name %>" style="width:44px;height:44px;border-radius:50%;object-fit:cover;">
                  <% } else { %>
                    <div style="width:44px;height:44px;border-radius:50%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;font-size:18px;">👤</div>
                  <% } %>
                </td>
                <td><strong><%= p.name %></strong></td>
                <td>
                  <span class="badge badge-<%= p.role_type==='provost'?'success':p.role_type==='assistant_provost'?'info':p.role_type==='staff'?'warning':'secondary' %>">
                    <%= p.role_type.replace('_',' ') %>
                  </span>
                </td>
                <td><%= p.designation||'—' %></td>
                <td><%= p.department||'—' %></td>
                <td style="font-size:12px;"><%= p.phone||'' %><% if(p.phone&&p.email){%><br><%}%><%= p.email||'' %></td>
                <td style="display:flex;gap:6px;">
                  <button class="btn btn-sm btn-outline" onclick='openEditPerson(<%- JSON.stringify({id:p.id,role_type:p.role_type,name:p.name,designation:p.designation,department:p.department,phone:p.phone,email:p.email,photo:p.photo,display_order:p.display_order}) %>)'>✏️ Edit</button>
                  <form action="/admin/administration/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Remove <%= p.name %> from Administration?')">
                    <button class="btn btn-sm btn-danger">🗑️</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } else { %>
          <div class="empty-state"><div class="empty-icon">🧑‍💼</div><p>No administration entries yet. Click "Add Person" to get started.</p></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Person Modal -->
<div class="modal-backdrop" id="addPersonModal">
  <div class="modal-box">
    <div class="modal-header">
      <h3>Add Administration Person</h3>
      <button class="modal-close" onclick="document.getElementById('addPersonModal').classList.remove('show')">✕</button>
    </div>
    <form action="/admin/administration/add" method="POST" enctype="multipart/form-data">
      <div class="form-group" style="text-align:center;margin-bottom:14px;">
        <img id="addPersonPhotoPreview" src="" alt="" style="width:80px;height:80px;border-radius:50%;object-fit:cover;display:none;margin:0 auto 8px;">
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="form-control" onchange="previewPhoto(this,'addPersonPhotoPreview')">
        <small style="color:var(--muted);">Upload a photo from your computer. JPG, PNG or WEBP, max 3MB.</small>
      </div>
      <div class="form-group">
        <label>Role *</label>
        <select name="role_type" class="form-control" required>
          <option value="provost">Provost</option>
          <option value="assistant_provost">Assistant Provost</option>
          <option value="staff">Hall Staff</option>
          <option value="contact">Other Contact</option>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Full Name *</label><input type="text" name="name" class="form-control" required></div>
        <div class="form-group"><label>Designation</label><input type="text" name="designation" class="form-control" placeholder="e.g. Professor"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Department</label><input type="text" name="department" class="form-control"></div>
        <div class="form-group"><label>Display Order</label><input type="number" name="display_order" class="form-control" value="0" min="0"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Phone</label><input type="text" name="phone" class="form-control"></div>
        <div class="form-group"><label>Email</label><input type="email" name="email" class="form-control"></div>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Add to Administration</button>
    </form>
  </div>
</div>

<!-- Edit Person Modal -->
<div class="modal-backdrop" id="editPersonModal">
  <div class="modal-box">
    <div class="modal-header">
      <h3>✏️ Edit Person</h3>
      <button class="modal-close" onclick="document.getElementById('editPersonModal').classList.remove('show')">✕</button>
    </div>
    <form id="editPersonForm" method="POST" enctype="multipart/form-data">
      <div class="form-group" style="text-align:center;margin-bottom:14px;">
        <img id="editPersonPhotoPreview" src="" alt="" style="width:80px;height:80px;border-radius:50%;object-fit:cover;display:none;margin:0 auto 8px;">
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="form-control" onchange="previewPhoto(this,'editPersonPhotoPreview')">
        <small style="color:var(--muted);">Leave empty to keep the current photo.</small>
      </div>
      <div class="form-group">
        <label>Role *</label>
        <select name="role_type" id="editPersonRole" class="form-control" required>
          <option value="provost">Provost</option>
          <option value="assistant_provost">Assistant Provost</option>
          <option value="staff">Hall Staff</option>
          <option value="contact">Other Contact</option>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Full Name *</label><input type="text" name="name" id="editPersonName" class="form-control" required></div>
        <div class="form-group"><label>Designation</label><input type="text" name="designation" id="editPersonDesignation" class="form-control"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Department</label><input type="text" name="department" id="editPersonDept" class="form-control"></div>
        <div class="form-group"><label>Display Order</label><input type="number" name="display_order" id="editPersonOrder" class="form-control" min="0"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Phone</label><input type="text" name="phone" id="editPersonPhone" class="form-control"></div>
        <div class="form-group"><label>Email</label><input type="email" name="email" id="editPersonEmail" class="form-control"></div>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
    </form>
  </div>
</div>

<script>
  function previewPhoto(input, previewId) {
    const preview = document.getElementById(previewId);
    if (input.files && input.files[0]) {
      preview.src = URL.createObjectURL(input.files[0]);
      preview.style.display = 'block';
    }
  }

  function openEditPerson(p) {
    document.getElementById('editPersonForm').action = `/admin/administration/${p.id}/update`;
    document.getElementById('editPersonRole').value = p.role_type;
    document.getElementById('editPersonName').value = p.name || '';
    document.getElementById('editPersonDesignation').value = p.designation || '';
    document.getElementById('editPersonDept').value = p.department || '';
    document.getElementById('editPersonOrder').value = p.display_order || 0;
    document.getElementById('editPersonPhone').value = p.phone || '';
    document.getElementById('editPersonEmail').value = p.email || '';

    const preview = document.getElementById('editPersonPhotoPreview');
    if (p.photo) {
      preview.src = `/uploads/administration/${p.photo}`;
      preview.style.display = 'block';
    } else {
      preview.style.display = 'none';
    }
    document.getElementById('editPersonModal').classList.add('show');
  }
</script>
</body></html>
