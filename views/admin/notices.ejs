<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — July-6 Hall</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main-content">
    <div class="topbar">
      <h1>📢 Notice Board</h1>
      <button class="btn btn-primary" onclick="document.getElementById('addNoticeModal').classList.add('show')">+ Post Notice</button>
    </div>
    <div class="page-content">
      <%- include('../partials/back-button') %>
      <% if (success.length) { %><div class="alert alert-success">✓ <%= success %></div><% } %>
      <div class="card">
        <div class="card-header"><h3>All Notices (<%= notices.length %>)</h3></div>
        <div class="card-body" id="noticesList">
          <% if (notices.length) { %>
            <% notices.forEach(n => { %>
            <div class="notice-item <%= n.priority==='urgent'?'urgent':'' %>" style="margin-bottom:16px;">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
                <div style="flex:1;">
                  <h4 style="font-size:15px;margin-bottom:6px;">
                    <% if(n.priority==='urgent'){%><span class="badge badge-danger" style="margin-right:6px;font-size:10px;">URGENT</span><%}%>
                    <%= n.title %>
                    <% if(n.status==='expired'){%><span class="badge badge-secondary" style="margin-left:6px;font-size:10px;">EXPIRED</span><%}%>
                  </h4>
                  <% if(n.image_filename){ %>
                  <img src="/uploads/notices/<%= n.image_filename %>" alt="Notice Image" style="max-width:100%;max-height:200px;border-radius:8px;object-fit:cover;margin-bottom:8px;display:block;">
                  <% } else if(n.image_url){ %>
                  <img src="<%= n.image_url %>" alt="Notice Image" style="max-width:100%;max-height:200px;border-radius:8px;object-fit:cover;margin-bottom:8px;display:block;"
                       onerror="this.style.display='none'">
                  <% } %>
                  <p style="font-size:13px;color:var(--muted);white-space:pre-wrap;"><%= n.content %></p>
                  <div class="notice-meta" style="margin-top:8px;">
                    📌 <%= n.posted_by_name %> · <%= new Date(n.created_at).toLocaleString() %>
                    <% if(n.publish_date){%> · 📅 Publishes: <%= new Date(n.publish_date).toLocaleDateString() %><%}%>
                    <% if(n.expiry_date){%> · ⏳ Expires: <%= new Date(n.expiry_date).toLocaleDateString() %><%}%>
                  </div>
                </div>
                <form action="/admin/notices/<%= n.id %>/delete" method="POST" onsubmit="return confirm('Delete?')">
                  <button class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            </div>
            <% }) %>
          <% } else { %>
          <div class="empty-state"><div class="empty-icon">📢</div><p>No notices yet.</p></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="modal-backdrop" id="addNoticeModal">
  <div class="modal-box">
    <div class="modal-header">
      <h3>Post New Notice</h3>
      <button class="modal-close" onclick="document.getElementById('addNoticeModal').classList.remove('show')">✕</button>
    </div>
    <form action="/admin/notices/add" method="POST" enctype="multipart/form-data">
      <div class="form-group"><label>Title *</label><input type="text" name="title" class="form-control" required></div>
      <div class="form-group"><label>Content *</label><textarea name="content" class="form-control" rows="5" required style="resize:vertical;"></textarea></div>
      <div class="form-group">
        <label>Upload Image (optional)</label>
        <input type="file" name="image" accept="image/jpeg,image/png,image/webp" class="form-control" onchange="previewNoticeImage(this)">
        <small style="color:var(--muted);font-size:11px;">Upload a photo from your computer, JPG/PNG/WEBP, max 5MB.</small>
        <img id="noticeImagePreview" src="" alt="" style="max-width:100%;max-height:160px;border-radius:8px;margin-top:8px;display:none;object-fit:cover;">
      </div>
      <div class="form-group">
        <label>Or Image URL (optional)</label>
        <input type="url" name="image_url" class="form-control" placeholder="https://example.com/image.jpg">
        <small style="color:var(--muted);font-size:11px;">Use this instead if you'd rather link an image than upload one. Uploaded file takes priority if both are provided.</small>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Publish Date</label><input type="date" name="publish_date" class="form-control"><small style="color:var(--muted);">Leave blank to publish immediately</small></div>
        <div class="form-group"><label>Expiry Date</label><input type="date" name="expiry_date" class="form-control"><small style="color:var(--muted);">Leave blank for no expiry</small></div>
      </div>
      <div class="form-group"><label>Priority</label>
        <select name="priority" class="form-control"><option value="normal">Normal</option><option value="urgent">Urgent</option></select>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Post Notice</button>
    </form>
  </div>
</div>
<script>
  function previewNoticeImage(input) {
    const preview = document.getElementById('noticeImagePreview');
    if (input.files && input.files[0]) {
      preview.src = URL.createObjectURL(input.files[0]);
      preview.style.display = 'block';
    }
  }
</script>
<script src="/socket.io/socket.io.js"></script>
<script>
  try {
    const socket = io();
    socket.on('notice:changed', () => location.reload());
  } catch (e) { console.warn('Socket.io unavailable on notices page.', e); }
</script>
</body></html>
