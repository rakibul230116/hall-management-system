<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Manage Students — July-6 Hall</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main-content">
    <div class="topbar"><h1>👥 Manage Students</h1></div>
    <div class="page-content">
      <%- include("../partials/back-button") %>
      <% if (success.length) { %><div class="alert alert-success">✓ <%= success %></div><% } %>
      <div class="card">
        <div class="card-header">
          <h3>All Students (<%= students.length %>)</h3>
          <form class="search-bar" action="/admin/students" method="GET">
            <input type="text" name="search" class="form-control" placeholder="Search name / ID / email..." value="<%= search||'' %>">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
            <% if(search){%><a href="/admin/students" class="btn btn-outline btn-sm">Clear</a><%}%>
          </form>
        </div>
        <div class="table-responsive">
          <% if (students.length) { %>
          <table class="data-table">
            <thead><tr><th>#</th><th>Photo</th><th>Name</th><th>Student ID</th><th>Email</th><th>Dept</th><th>Session</th><th>Room</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
              <% students.forEach((s,i) => { %>
              <tr>
                <td><%= i+1 %></td>
                <td>
                  <% if (s.photo) { %>
                    <img src="/uploads/profiles/<%= s.photo %>" alt="<%= s.name %>" style="width:36px;height:36px;border-radius:50%;object-fit:cover;">
                  <% } else { %>
                    <div style="width:36px;height:36px;border-radius:50%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;font-size:14px;color:#64748b;">👤</div>
                  <% } %>
                </td>
                <td><strong><%= s.name %></strong></td>
                <td><code><%= s.student_id||'—' %></code></td>
                <td style="font-size:12px;"><%= s.email %></td>
                <td><%= s.department||'—' %></td>
                <td><%= s.session||'—' %></td>
                <td>
                  <% if(s.room_number){%><span class="badge badge-info">🏠 <%= s.room_number %></span>
                  <%}else{%><span class="badge badge-secondary">Not Allocated</span><%}%>
                </td>
                <td><span class="badge badge-<%= s.status==='active'?'success':'danger' %>"><%= s.status %></span></td>
                <td style="display:flex;gap:6px;flex-wrap:wrap;">
                  <form action="/admin/students/<%= s.id %>/status" method="POST">
                    <select name="status" class="form-control" style="width:100px;padding:4px 8px;font-size:12px;" onchange="this.form.submit()">
                      <option value="active" <%= s.status==='active'?'selected':'' %>>Active</option>
                      <option value="inactive" <%= s.status==='inactive'?'selected':'' %>>Inactive</option>
                    </select>
                  </form>
                  <button class="btn btn-sm btn-outline" onclick='openEditStudent(<%- JSON.stringify({id:s.id,name:s.name,email:s.email,student_id:s.student_id,phone:s.phone,department:s.department,session:s.session,gender:s.gender,photo:s.photo}) %>)'>✏️ Edit</button>
                  <form action="/admin/students/<%= s.id %>/delete" method="POST" onsubmit="return confirm('Delete student <%= s.name %>? This also vacates their seat. This cannot be undone.')">
                    <button class="btn btn-sm btn-danger">🗑️ Delete</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <% } else { %>
          <div class="empty-state"><div class="empty-icon">👥</div><p>No students found.</p></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Student Modal -->
<div class="modal-backdrop" id="editStudentModal">
  <div class="modal-box">
    <div class="modal-header">
      <h3>✏️ Edit Student</h3>
      <button class="modal-close" onclick="document.getElementById('editStudentModal').classList.remove('show')">✕</button>
    </div>
    <form id="editStudentForm" method="POST" enctype="multipart/form-data">
      <div class="form-group" style="text-align:center;margin-bottom:14px;">
        <img id="editStudentPhotoPreview" src="" alt="" style="width:72px;height:72px;border-radius:50%;object-fit:cover;display:none;margin:0 auto 8px;">
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="form-control" onchange="previewEditPhoto(this)">
        <small style="color:var(--muted);">JPG, PNG or WEBP, max 3MB. Leave empty to keep current photo.</small>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Full Name *</label><input type="text" name="name" id="editStudentName" class="form-control" required></div>
        <div class="form-group"><label>Email *</label><input type="email" name="email" id="editStudentEmail" class="form-control" required></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Student ID</label><input type="text" name="student_id" id="editStudentSid" class="form-control"></div>
        <div class="form-group"><label>Phone</label><input type="text" name="phone" id="editStudentPhone" class="form-control"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Department</label><input type="text" name="department" id="editStudentDept" class="form-control"></div>
        <div class="form-group"><label>Session</label><input type="text" name="session" id="editStudentSession" class="form-control"></div>
      </div>
      <div class="form-group">
        <label>Gender</label>
        <select name="gender" id="editStudentGender" class="form-control">
          <option value="male">Male</option><option value="female">Female</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
    </form>
  </div>
</div>

<script>
  function openEditStudent(s) {
    document.getElementById('editStudentForm').action = `/admin/students/${s.id}/update`;
    document.getElementById('editStudentName').value = s.name || '';
    document.getElementById('editStudentEmail').value = s.email || '';
    document.getElementById('editStudentSid').value = s.student_id || '';
    document.getElementById('editStudentPhone').value = s.phone || '';
    document.getElementById('editStudentDept').value = s.department || '';
    document.getElementById('editStudentSession').value = s.session || '';
    document.getElementById('editStudentGender').value = s.gender || 'male';

    const preview = document.getElementById('editStudentPhotoPreview');
    if (s.photo) {
      preview.src = `/uploads/profiles/${s.photo}`;
      preview.style.display = 'block';
    } else {
      preview.style.display = 'none';
    }
    document.getElementById('editStudentModal').classList.add('show');
  }

  function previewEditPhoto(input) {
    const preview = document.getElementById('editStudentPhotoPreview');
    if (input.files && input.files[0]) {
      preview.src = URL.createObjectURL(input.files[0]);
      preview.style.display = 'block';
    }
  }
</script>
</body></html>
