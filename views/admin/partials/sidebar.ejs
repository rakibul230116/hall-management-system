    <a href="/admin/notices" class="<%= title==='Notice Board'?'active':'' %>"><span class="nav-icon">📢</span> Notices</a>
    <a href="/admin/complaints" class="<%= title==='Complaints'?'active':'' %>"><span class="nav-icon">📝</span> Complaints</a>
    <a href="/admin/administration" class="<%= title==='Administration'?'active':'' %>"><span class="nav-icon">🧑‍💼</span> Administration</a>
