    <a href="/admin/reports" class="<%= title==='Reports'?'active':'' %>"><span class="nav-icon">📈</span> Reports</a>
  </nav>
  <div class="sidebar-footer">
    <a href="/" style="color:rgba(255,255,255,.6);font-size:12px;display:block;margin-bottom:8px;">🏠 Home Page</a>
