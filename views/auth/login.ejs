<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — July-6 Hall</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body{margin:0;padding:0;}
    .auth-page{min-height:100vh;display:flex;align-items:stretch;position:relative;}
    .auth-left{
      flex:1;position:relative;display:flex;align-items:center;justify-content:center;
      padding:40px;min-height:100vh;
    }
    .auth-left-bg{
      position:absolute;inset:0;
      background:url('/images/hall-bg.jpg') center/cover no-repeat;
    }
    .auth-left-bg::after{
      content:'';position:absolute;inset:0;
      background:linear-gradient(160deg,rgba(10,35,66,0.88),rgba(10,60,120,0.80));
    }
    .auth-left-content{position:relative;z-index:1;text-align:center;color:#fff;max-width:420px;}
    .hall-logo-wrap{margin-bottom:20px;}
    .hall-logo{width:90px;height:90px;border-radius:50%;object-fit:contain;background:#fff;padding:5px;border:3px solid var(--accent);}
    .hall-logo-fallback{width:90px;height:90px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;font-size:40px;margin:0 auto;}
    .auth-left-content h1{font-size:34px;font-weight:900;margin-bottom:8px;line-height:1.1;}
    .auth-left-content h1 span{color:var(--accent);}
    .auth-left-content p{font-size:14px;opacity:.8;line-height:1.7;margin-bottom:24px;}
    .hall-stats{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;}
    .hstat{text-align:center;}
    .hstat-num{font-size:22px;font-weight:900;color:var(--accent);}
    .hstat-lbl{font-size:11px;opacity:.7;}
    .auth-right{
      width:440px;flex-shrink:0;background:#fff;display:flex;align-items:center;justify-content:center;
      padding:40px 44px;box-shadow:-8px 0 40px rgba(0,0,0,0.15);
    }
    .auth-form-box{width:100%;}
    .form-logo{display:flex;align-items:center;gap:12px;margin-bottom:28px;}
    .form-logo img{width:44px;height:44px;border-radius:50%;object-fit:contain;background:var(--bg);padding:2px;border:2px solid var(--primary);}
    .form-logo-fallback{width:44px;height:44px;border-radius:50%;background:var(--primary);display:flex;align-items:center;justify-content:center;font-size:20px;}
    .form-logo-text h2{font-size:16px;font-weight:800;color:var(--primary);line-height:1.1;}
    .form-logo-text span{font-size:11px;color:var(--muted);}
    .form-title{font-size:22px;font-weight:800;color:var(--text);margin-bottom:6px;}
    .form-sub{font-size:13px;color:var(--muted);margin-bottom:24px;}
    .divider{height:1px;background:var(--border);margin:20px 0;}
    @media(max-width:768px){
      .auth-left{display:none;}
      .auth-right{width:100%;box-shadow:none;padding:32px 24px;}
    }
  </style>
</head>
<body>
<div class="auth-page">
  <!-- Left: Hall image + info -->
  <div class="auth-left">
    <div class="auth-left-bg"></div>
    <div class="auth-left-content">
      <div class="hall-logo-wrap">
        <img src="/images/pust-logo.png" alt="PUST" class="hall-logo"
             onerror="this.style.display='none';document.getElementById('llf').style.display='flex';">
        <div class="hall-logo-fallback" id="llf" style="display:none;">🏛️</div>
      </div>
      <h1>July-6 <span>Hall</span></h1>
      <p>Pabna University of Science & Technology<br>Your digital hall management portal</p>
      <div class="hall-stats">
        <div class="hstat"><div class="hstat-num">400+</div><div class="hstat-lbl">Students</div></div>
        <div class="hstat"><div class="hstat-num">100+</div><div class="hstat-lbl">Rooms</div></div>
        <div class="hstat"><div class="hstat-num">24/7</div><div class="hstat-lbl">Support</div></div>
      </div>
    </div>
  </div>

  <!-- Right: Login form -->
  <div class="auth-right">
    <div class="auth-form-box">
      <div class="form-logo">
        <img src="/images/pust-logo.png" alt="PUST"
             onerror="this.style.display='none';document.getElementById('flf').style.display='flex';">
        <div class="form-logo-fallback" id="flf" style="display:none;">🏛️</div>
        <div class="form-logo-text">
          <h2>July-6 Hall</h2>
          <span>PUST Hall Management</span>
        </div>
      </div>

      <div class="form-title">Welcome Back 👋</div>
      <div class="form-sub">Sign in to your hall portal account</div>

      <% if (success.length) { %><div class="alert alert-success">✓ <%= success %></div><% } %>
      <% if (error.length) { %><div class="alert alert-error">✕ <%= error %></div><% } %>

      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label>📧 Email Address</label>
          <input type="email" name="email" class="form-control" placeholder="your@email.com" required autofocus>
        </div>
        <div class="form-group">
          <label>🔒 Password</label>
          <div class="password-field">
            <input type="password" name="password" id="loginPwInput" class="form-control" placeholder="••••••••" required>
            <button type="button" class="password-toggle" onclick="toggleLoginPw()" aria-label="Show password">👁️</button>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin:-4px 0 14px;">
          <label style="display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted);cursor:pointer;">
            <input type="checkbox" name="remember_me" value="1" style="width:auto;">
            Remember Me
          </label>
          <a href="/auth/forgot-password" style="font-size:13px;color:var(--primary);font-weight:600;">Forgot Password?</a>
        </div>
        <button type="submit" class="btn btn-primary btn-full" style="padding:12px;font-size:15px;margin-top:8px;">
          Sign In →
        </button>
      </form>

      <div class="divider"></div>
      <p style="text-align:center;font-size:13px;color:var(--muted);">
        New student? <a href="/auth/register" style="font-weight:700;color:var(--primary);">Register here</a>
      </p>
      <p style="text-align:center;font-size:13px;color:var(--muted);margin-top:8px;">
        <a href="/" style="color:var(--muted);">← Back to Home</a>
      </p>
    </div>
  </div>
</div>
<script>
  function toggleLoginPw() {
    const input = document.getElementById('loginPwInput');
    const btn = event.currentTarget;
    const showing = input.type === 'text';
    input.type = showing ? 'password' : 'text';
    btn.textContent = showing ? '👁️' : '🙈';
  }
</script>
</body>
</html>
